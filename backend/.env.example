# Neon Postgres
DATABASE_URL=

# Neon Auth (Better Auth)
NEON_AUTH_BASE_URL=
NEON_AUTH_COOKIE_SECRET=

# Plaid
PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ENV=sandbox

# Coinbase (defer until ready)
COINBASE_API_KEY=
COINBASE_API_SECRET=

# App
PORT=3001
JWT_SECRET=
APP_URL=http://localhost:3001
CORS_ORIGIN=http://localhost:5173

# Encryption key for Plaid access tokens (generate: openssl rand -base64 32)
# Falls back to JWT_SECRET if not set
ENCRYPTION_KEY=

# Signup restriction — comma-separated list of allowed emails (leave empty to allow all)
ALLOWED_EMAILS=
